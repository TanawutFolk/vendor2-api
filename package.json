  "scripts": {
    "dev": "cross-env NODE_ENV=development bun --watch src/index.ts",
    "dev:prod": "cross-env NODE_ENV=production tsx watch src/index.ts",
    "db:normalize:inspect": "bun scripts/database-normalization.ts",
    "db:normalize:schema": "bun scripts/database-normalization.ts --schema",
    "db:normalize:apply": "bun scripts/database-normalization.ts --apply",
    "db:normalize:resume": "bun scripts/database-normalization.ts --resume",
    "db:normalize:repair-gpr-fks": "bun scripts/database-normalization.ts --repair-gpr-fks",
    "db:normalize:repair-approval-step": "bun scripts/database-normalization.ts --repair-approval-step",
    "db:normalize:smoke": "bun scripts/database-normalization-smoke.ts",
    "db:normalize:gpr-setup": "bun scripts/database-normalization.ts --apply-gpr-setup",
    "db:audit:inspect": "bun scripts/database-audit-normalization.ts",
    "db:audit:apply": "bun scripts/database-audit-normalization.ts --apply",
    "db:reject-reason:inspect": "bun scripts/database-reject-reason.ts",
    "db:reject-reason:apply": "bun scripts/database-reject-reason.ts --apply",
    "test:vendor:unit": "bun test src/config/mailTemplate.test.ts src/_workspace/sql/_approval-queue/ApprovalQueueSQL.test.ts src/_workspace/sql/_request-register/RequestRegisterPageSQL.test.ts src/_workspace/sql/_black-list/BlacklistSQL.test.ts src/_workspace/sql/_find-vendor/FindVendorSQL.test.ts src/_workspace/sql/_approval-GPRC/GprCApprovalSQL.test.ts src/_workspace/services/_request-register/RegisterRequestWorkflowHelper.test.ts src/_workspace/services/_approval-GPRC/GprCApprovalService.test.ts src/_workspace/services/_task-manager/TaskManagerRules.test.ts",
    "sql:vendor:pattern": "bun scripts/vendor-sql-pattern-smoke.ts",
    "test:vendor:db": "bun run db:audit:inspect && bun run db:normalize:smoke",
    "test:vendor": "bun run test:vendor:unit && bun run test:vendor:db",
    "build:prod": "npm run format && npm run lint && cross-env NODE_ENV=production tsc --project tsconfig.json && tsc-alias -p tsconfig.json",
    "start:prod": "cross-env NODE_ENV=production node -r tsconfig-paths/register dist/index.js",
    "build:azure": "npm run lint && cross-env NODE_ENV=azure tsc --project tsconfig.json && tsc-alias -p tsconfig.json",
    "start:azure": "cross-env NODE_ENV=azure node -r tsconfig-paths/register dist/index.js",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write 'src/**/*.{js,ts,tsx}'"
  },
